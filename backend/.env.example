APP_NAME=Email Threat Detection Platform
ENVIRONMENT=production
DEBUG=false

# Render PostgreSQL internal database URL.
DATABASE_URL=postgresql://user:password@host:5432/database

# Required for auth endpoints in production. Generate a strong random value in Render.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional threat intelligence providers. Leave empty until keys are available.
THREATFOX_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_API_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# Comma-separated frontend origins. Do not include paths like /login.
CORS_ORIGINS=https://sih-2026-project-blush.vercel.app,http://localhost:5173
